{
  "schemaVersion": 1,
  "id": "packed_packs",
  "version": "${version}",
  "name": "Packed Packs",
  "description": "Organize and pack resource packs.",
  "authors": [
    "fishstiz"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "MIT",
  "icon": "assets/packed_packs/icon.png",
  "environment": "client",
  "entrypoints": {
    "minecraft-cursor": [
      "io.github.fishstiz.packed_packs.compat.minecraftcursor.PackedPacksMinecraftCursor"
    ]
  },
  "mixins": [
    {
      "config": "packed_packs.mixins.json",
      "environment": "client"
    },
    {
      "config": "fidgetz.mixin.json",
      "environment": "client"
    }
  ],
  "accessWidener": "packed_packs.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "minecraft-cursor": ">=3.6.0"
  }
}