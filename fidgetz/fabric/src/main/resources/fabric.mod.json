{
  "schemaVersion": 1,
  "id": "fidgetz",
  "version": "${mod_version}",
  "name": "Fidgetz",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "environment": "client",
  "mixins": [
    "fidgetz.mixins.json",
    "fidgetz.fabric.mixins.json"
  ],
  "accessWidener": "fidgetz.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  }
}
